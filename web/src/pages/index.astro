---
import Layout from "../layouts/Layout.astro";
import { resolveDownloads } from "../lib/releases";

// Point of truth for downloads: prebuilt binaries are attached to GitHub
// Releases by .github/workflows/release.yml. The URLs are resolved at BUILD
// time from the Releases API (src/lib/releases.ts) so the buttons link straight
// at the file instead of dumping the visitor on the Releases list — the same
// arrangement soroban and dorado use. Every URL degrades to the Releases page
// if the lookup fails, so no version is ever hardcoded here.
const REPO = "https://github.com/alleato-llc/tty";
const dl = await resolveDownloads();
const LATEST = dl.releasesPage;
const COFFEE = "https://buymeacoffee.com/alleato";

// A theme-swapping screenshot: dark (Dracula) + light (GitHub Light) variants, shown/hidden
// by the page's theme via CSS (.shot-dark / .shot-light), so the captures re-skin with the
// ◐ toggle the same way the app does.
const shot = (name: string, alt: string, extra = "") =>
  `<img class="shot shot-dark ${extra}" src="/shots/${name}.png" alt="${alt}" />` +
  `<img class="shot shot-light ${extra}" src="/shots/${name}-light.png" alt="${alt}" />`;

// The whole slide deck is one raw-HTML string injected with `set:html`. Every
// terminal shown is a real screenshot of the app (web/public/shots/*, rendered by
// the actual wgpu path — see snapshot.rs `generate_landing_shots`), never a mockup.
const deck = `
  <!-- 1 — hero -->
  <section class="slide active">
    <div class="inner" style="text-align:center">
      <div class="kicker">A terminal written in Rust</div>
      <h1>tty<span style="color:var(--accent)">.</span></h1>
      <p class="lede" style="margin-inline:auto">
        A <b>fast, focused</b> terminal with the old-school feel — a GPU-rendered grid
        that repaints the instant output lands and sleeps when it doesn't.
        <b>No browser, no bloat.</b>
      </p>
      ${shot("hero", "tty terminal showing colored ls output", "big")}
      <div class="cta">
        <a class="btn primary" href="${dl.macDmg}">Download tty <span class="sub">for macOS</span></a>
        <a class="btn ghost" href="${REPO}">View on GitHub</a>
      </div>
    </div>
  </section>

  <!-- 2 — speed / output-driven repaint -->
  <section class="slide">
    <div class="inner cols">
      <div>
        <div class="kicker">Built for speed</div>
        <h2>Repaints on output. Silent when idle.</h2>
        <ul class="feat">
          <li><b>Native Rust</b>, GPU-rendered with wgpu — keystrokes echo and output paints in microseconds.</li>
          <li><b>Output-driven repaint</b>: the screen redraws exactly when the shell writes, and costs nothing while it waits. No 60fps idle spin.</li>
          <li>One process, <b>instant startup</b>, a memory footprint you'd have to go looking for.</li>
        </ul>
      </div>
      ${shot("build", "tty running a cargo build")}
    </div>
  </section>

  <!-- 3 — tabs, splits & windows -->
  <section class="slide">
    <div class="inner cols">
      <div>
        <div class="kicker">Tabs, splits &amp; windows</div>
        <h2>Arrange your shells your way.</h2>
        <ul class="feat">
          <li><b>Tabs</b> — <kbd>⌘T</kbd> new, <kbd>⌘W</kbd> close, <kbd>⌘1</kbd>–<kbd>⌘9</kbd> jump. The strip only appears once you have more than one.</li>
          <li><b>Split any pane</b> — <kbd>⌥⌘</kbd>+arrows split in any direction, <kbd>⌃⌘</kbd>+arrows move focus, drag the divider to resize.</li>
          <li><b>Tear a tab off</b> into its own window — and drop it back when you're done.</li>
        </ul>
      </div>
      ${shot("splits", "tty split into two side-by-side panes")}
    </div>
  </section>

  <!-- 4 — shell-aware (OSC 133) -->
  <section class="slide">
    <div class="inner cols">
      <div>
        <div class="kicker">It understands your shell</div>
        <h2>Jump to prompts. Spot failures. Click into your editor.</h2>
        <ul class="feat">
          <li><b>Prompt jump</b> — <kbd>⌘↑</kbd>/<kbd>⌘↓</kbd> hop between commands, or straight to the last one that <b>failed</b>.</li>
          <li>An optional <b>gutter</b> marks every prompt — a red dot when a command exits non-zero.</li>
          <li><kbd>⌘</kbd>-click a <code>path:line:col</code> in output to open it in your editor; <kbd>⌘</kbd>-click a URL to open your browser.</li>
          <li>Built on OSC 133 shell integration — opt in, and it stays out of the way.</li>
        </ul>
      </div>
      ${shot("shell", "tty prompt gutter with a red dot on a failed command")}
    </div>
  </section>

  <!-- 5 — scrollback + copy -->
  <section class="slide">
    <div class="inner cols">
      <div>
        <div class="kicker">Scrollback &amp; copy</div>
        <h2>Scroll back. Drag. Copy.</h2>
        <ul class="feat">
          <li><b>Real scrollback</b> with <kbd>⌘F</kbd> search; the live screen snaps back the moment you're at the bottom.</li>
          <li><b>Click-drag to select</b>, <kbd>⌘C</kbd> to copy. <kbd>Ctrl+C</kbd> stays a real <span class="pill" style="margin:0">SIGINT</span> to the shell.</li>
          <li>Full ANSI — 16-color, 256-color, truecolor, plus bold, dim, italic, underline and inverse.</li>
        </ul>
      </div>
      ${shot("scrollback", "tty scrollback with colored git and ls output")}
    </div>
  </section>

  <!-- 6 — command history (encrypted, opt-in) -->
  <section class="slide">
    <div class="inner cols">
      <div>
        <div class="kicker">Command history, your call</div>
        <h2>Recall every command — or none.</h2>
        <ul class="feat">
          <li><kbd>⌘⇧H</kbd> opens a <b>searchable log</b> of what you've run — each command's output a click away.</li>
          <li><b>Opt in to persist it</b> across launches, <b>encrypted at rest</b> — command text only, never output.</li>
          <li>Or the other way: <kbd>⌘⇧T</kbd> opens an <b>untracked</b> tab, and <code>--untracked</code> a whole session that records nothing.</li>
          <li>Off by default — nothing is stored unless you say so.</li>
        </ul>
      </div>
      ${shot("history", "tty's searchable ⌘⇧H command history panel")}
    </div>
  </section>

  <!-- 7 — make it yours (themes + ligatures) -->
  <section class="slide">
    <div class="inner">
      <div class="kicker" style="text-align:center">Make it yours</div>
      <h2 style="text-align:center; margin-bottom:6px">Dark or light, chrome <i>and</i> grid.</h2>
      <p class="lede" style="margin:0 auto 22px; text-align:center">
        8 built-in themes (or import any <a href="https://github.com/chriskempson/base16">base16</a>),
        the font of your choice, and programming ligatures when it ships them.
        <b>Try the ◐ toggle up top.</b>
      </p>
      <div class="shots-grid">
        <figure><img class="shot" src="/shots/theme-phosphor.png" alt="Phosphor theme" /><figcaption>Phosphor</figcaption></figure>
        <figure><img class="shot" src="/shots/theme-dracula.png" alt="Dracula theme" /><figcaption>Dracula</figcaption></figure>
        <figure><img class="shot" src="/shots/theme-solarized.png" alt="Solarized Light theme" /><figcaption>Solarized</figcaption></figure>
        <figure><img class="shot" src="/shots/theme-light.png" alt="GitHub Light theme" /><figcaption>GitHub Light</figcaption></figure>
      </div>
    </div>
  </section>

  <!-- 8 — status bar / widgets (optional, configurable) -->
  <section class="slide">
    <div class="inner cols">
      <div>
        <div class="kicker">A status bar, if you want one</div>
        <h2>Glance at what matters. Or add nothing at all.</h2>
        <ul class="feat">
          <li><b>Completely optional</b> — add only the cells you care about: CPU, memory, network, disk, battery, uptime, a clock, the busiest process.</li>
          <li><b>Yours to arrange</b> — reorder them, pick a sparkline or a plain number, set your own warn/alarm thresholds.</li>
          <li><b>Click to drill in</b> — any cell opens a full chart, and a chart can <b>graduate into its own pane</b> beside the terminal.</li>
        </ul>
      </div>
      ${shot("widgets", "tty's configurable status-bar metrics with a CPU chart drilled in")}
    </div>
  </section>

  <!-- 9 — embeddable -->
  <section class="slide">
    <div class="inner cols">
      <div>
        <div class="kicker">An engine, a widget, an app</div>
        <h2>A terminal you can embed.</h2>
        <ul class="feat">
          <li><b>cathode</b> — the engine: a VT/ANSI parser, the screen grid, and a real PTY. Pure Rust, no UI.</li>
          <li><b>phosphor</b> — the iced widget that renders it: colors, attributes, scrollback, mouse copy.</li>
          <li>tty is thin glue over the two — so the <i>same</i> crates drop straight into any iced app that wants a terminal panel.</li>
        </ul>
      </div>
      ${shot("embed", "the phosphor terminal widget shown in source")}
    </div>
  </section>

  <!-- 10 — closer / download -->
  <section class="slide">
    <div class="inner" style="text-align:center">
      <div class="kicker">Native. Fast. Yours.</div>
      <h1 style="font-size:clamp(34px,6vw,64px)">Give tty a run.</h1>
      <p class="lede" style="margin:18px auto 0">
        Grab the signed, notarized macOS app, take the Linux build, or clone and
        run it yourself — you'll be at a prompt in seconds. Built on Rust + iced,
        GPU-rendered with wgpu. Windows is on the way.
      </p>
      <div class="downloads">
        <a class="dl" href="${dl.macDmg}"><span class="plat">Download for macOS</span><span class="arch">universal · Apple Silicon + Intel</span></a>
        <a class="dl" href="${dl.linuxX64}"><span class="plat">Download for Linux</span><span class="arch">x86-64 · tar.gz</span></a>
      </div>
      <p class="fine" style="margin-top:10px">
        <a href="${LATEST}">All downloads</a>
      </p>
      <div class="install">
        <div class="run">cargo run -p tty</div>
      </div>
      <div class="cta" style="margin-top:24px">
        <a class="btn ghost" href="${REPO}">View on GitHub</a>
        <a class="btn coffee" href="${COFFEE}">☕ Buy me a coffee</a>
      </div>
    </div>
  </section>
`;
---

<Layout
  title="tty — the fast terminal in Rust"
  description="tty is a fast, focused, GPU-accelerated terminal written in Rust — tabs, split panes, shell-aware prompt jumping, scrollback, mouse select & copy, full ANSI color, themes, and output-driven repaint. Built on the cathode engine and phosphor widget. No Electron."
>
  <div class="hint">
    <span class="hint-key">← → or space to explore</span><span class="hint-touch">swipe to explore</span>
  </div>
  <div class="brand-foot">Rust · wgpu · zero Electron</div>

  <div class="deck" id="deck" set:html={deck}></div>

  <div class="nav">
    <div class="arrows"><button id="prev" aria-label="previous">‹</button></div>
    <div class="dots" id="dots"></div>
    <div class="arrows"><button id="next" aria-label="next">›</button></div>
    <div class="count" id="count"></div>
  </div>

  <script>
    const slides = [...document.querySelectorAll(".slide")];
    const dotsEl = document.getElementById("dots")!;
    const countEl = document.getElementById("count")!;
    let i = 0;
    slides.forEach((_, n) => {
      const b = document.createElement("b");
      b.onclick = () => go(n);
      dotsEl.appendChild(b);
    });
    const dots = [...dotsEl.children];
    function go(n: number) {
      i = Math.max(0, Math.min(slides.length - 1, n));
      slides.forEach((s, k) => s.classList.toggle("active", k === i));
      dots.forEach((d, k) => d.classList.toggle("on", k === i));
      countEl.textContent = i + 1 + " / " + slides.length;
      history.replaceState(null, "", "#" + i);
    }
    document.getElementById("next")!.onclick = () => go(i + 1);
    document.getElementById("prev")!.onclick = () => go(i - 1);
    addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight" || e.key === " " || e.key === "PageDown") {
        go(i + 1);
        e.preventDefault();
      }
      if (e.key === "ArrowLeft" || e.key === "PageUp") {
        go(i - 1);
        e.preventDefault();
      }
      if (e.key === "Home") go(0);
      if (e.key === "End") go(slides.length - 1);
    });
    // Touch: swipe left/right to move between slides. The deck previously had
    // no touch handling at all — on a phone the only affordances were the small
    // arrows and dots, and the keyboard hint doesn't apply.
    //
    // Only a predominantly HORIZONTAL gesture navigates. Slides scroll
    // vertically now (see `.slide { overflow-y: auto }`), so a mostly-vertical
    // drag must be left alone for the browser to scroll with — hence the
    // |dx| > |dy| test and the passive listeners (never preventDefault, so
    // scrolling is never blocked).
    const SWIPE_MIN = 50; // px of horizontal travel before it counts
    let sx = 0,
      sy = 0;
    addEventListener(
      "touchstart",
      (e) => {
        sx = e.changedTouches[0].clientX;
        sy = e.changedTouches[0].clientY;
      },
      { passive: true },
    );
    addEventListener(
      "touchend",
      (e) => {
        const dx = e.changedTouches[0].clientX - sx;
        const dy = e.changedTouches[0].clientY - sy;
        if (Math.abs(dx) < SWIPE_MIN || Math.abs(dx) <= Math.abs(dy)) return;
        go(dx < 0 ? i + 1 : i - 1);
      },
      { passive: true },
    );

    const start = parseInt(location.hash.slice(1), 10);
    go(Number.isInteger(start) ? start : 0);
  </script>
</Layout>
