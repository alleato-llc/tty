---
import Layout from "../layouts/Layout.astro";

// Point of truth for downloads: prebuilt binaries are attached to GitHub
// Releases by .github/workflows/release.yml. `/releases/latest` always resolves
// to the newest release, so the buttons never need a hardcoded version.
const REPO = "https://github.com/alleato-llc/tty";
const LATEST = `${REPO}/releases/latest`;
const COFFEE = "https://buymeacoffee.com/alleato";

// The whole slide deck is one raw-HTML string injected with `set:html` — the
// terminal mockups are full of literal `{ }`, which Astro would otherwise parse
// as JSX. A template literal sidesteps that; it interpolates only `${...}`.
const deck = `
  <!-- 1 — hero -->
  <section class="slide active">
    <div class="inner" style="text-align:center">
      <div class="kicker">A terminal written in Rust</div>
      <h1>tty<span style="color:var(--accent)">.</span></h1>
      <p class="lede" style="margin-inline:auto">
        A <b>fast, focused</b> terminal with the old-school feel — tabs, scrollback,
        select &amp; copy, and a GPU-rendered grid that repaints the instant output
        lands and sleeps when it doesn't. <b>No browser, no bloat.</b>
      </p>
      <div style="margin-top:24px">
        <span class="pill">⚡ native speed</span>
        <span class="pill">GPU-rendered</span>
        <span class="pill">tabs</span>
        <span class="pill">scrollback + copy</span>
        <span class="pill">no Electron</span>
      </div>
      <div class="cta">
        <a class="btn primary" href="${LATEST}">Download tty <span class="sub">for macOS</span></a>
        <a class="btn ghost" href="${REPO}">View on GitHub</a>
      </div>
    </div>
  </section>

  <!-- 2 — speed / output-driven repaint -->
  <section class="slide">
    <div class="inner cols">
      <div>
        <div class="kicker">Built for speed</div>
        <h2>Repaints on output. Silent when idle.</h2>
        <ul class="feat">
          <li><b>Native Rust</b>, rendered on the GPU with wgpu — keystrokes echo and output paints in microseconds.</li>
          <li><b>Output-driven repaint</b>: the screen redraws exactly when the shell writes, and costs nothing while it waits. No 60fps idle spin.</li>
          <li>One process, <b>instant startup</b>, a memory footprint you'd have to go looking for.</li>
        </ul>
      </div>
      <div class="win">
        <div class="bar"><div class="dot r"></div><div class="dot y"></div><div class="dot g"></div></div>
        <div class="code">
          <div class="ln"><div class="c"><span class="f">~/dev/tty</span> <span class="k">$</span> cargo build --release</div></div>
          <div class="ln"><div class="c"><span class="cm">   Compiling cathode v0.1.0</span></div></div>
          <div class="ln"><div class="c"><span class="cm">   Compiling phosphor v0.1.0</span></div></div>
          <div class="ln"><div class="c"><span class="t">    Finished</span> \`release\` in 9.4s</div></div>
          <div class="ln cur"><div class="c"><span class="f">~/dev/tty</span> <span class="k">$</span> <span class="caret"></span></div></div>
        </div>
        <div class="foot"><span>zsh</span><span>80×24 · output-driven · 14px</span></div>
      </div>
    </div>
  </section>

  <!-- 3 — tabs -->
  <section class="slide">
    <div class="inner cols">
      <div>
        <div class="kicker">Tabs</div>
        <h2>One window. Every shell.</h2>
        <ul class="feat">
          <li><b>Multi-tab</b> — <kbd>⌘T</kbd> / <kbd>⌘N</kbd> new, <kbd>⌘W</kbd> close, <kbd>⌘1</kbd>–<kbd>⌘9</kbd> jump.</li>
          <li>Type <code>exit</code> and the tab closes itself; close the last one and the window goes with it.</li>
          <li>Minimalist by default — the tab strip only appears once you have more than one.</li>
        </ul>
      </div>
      <div class="win">
        <div class="bar"><div class="dot r"></div><div class="dot y"></div><div class="dot g"></div></div>
        <div class="tabs"><div class="tab active">● zsh</div><div class="tab">server</div><div class="tab">logs</div></div>
        <div class="code">
          <div class="ln"><div class="c"><span class="f">~/dev/tty</span> <span class="k">$</span> git status</div></div>
          <div class="ln"><div class="c"><span class="t">On branch</span> main</div></div>
          <div class="ln cur"><div class="c"><span class="f">~/dev/tty</span> <span class="k">$</span> <span class="caret"></span></div></div>
        </div>
        <div class="foot"><span>zsh</span><span>3 tabs · ⌘1–⌘3</span></div>
      </div>
    </div>
  </section>

  <!-- 4 — scrollback + select/copy -->
  <section class="slide">
    <div class="inner cols">
      <div>
        <div class="kicker">Scrollback &amp; copy</div>
        <h2>Scroll back. Drag. Copy.</h2>
        <ul class="feat">
          <li><b>Real scrollback</b> — wheel up through history; the live screen snaps back the moment you're at the bottom.</li>
          <li><b>Mouse selection</b> — click-drag to select, <kbd>⌘C</kbd> to copy. <kbd>Ctrl+C</kbd> stays a real <span class="pill" style="margin:0">SIGINT</span> to the shell.</li>
          <li>Full ANSI: 16-color, 256-color, truecolor, plus bold, dim, italic, underline and inverse.</li>
        </ul>
      </div>
      <div class="win">
        <div class="bar"><div class="dot r"></div><div class="dot y"></div><div class="dot g"></div></div>
        <div class="code">
          <div class="ln"><div class="c"><span class="k">$</span> ls --color</div></div>
          <div class="ln"><div class="c"><span class="t">src</span>  <span class="f">README.md</span>  <span class="k">target</span>  Cargo.toml</div></div>
          <div class="ln"><div class="c"><span class="s">warn</span>: <u>unused</u>  <span class="n">256-orange</span>  truecolor</div></div>
          <div class="ln cur"><div class="c"><span class="k">$</span> <span class="caret"></span></div></div>
        </div>
        <div class="foot"><span>zsh</span><span>⌘C copy · scrollback 5000</span></div>
      </div>
    </div>
  </section>

  <!-- 5 — zoom -->
  <section class="slide">
    <div class="inner">
      <div class="kicker" style="text-align:center">Font zoom</div>
      <h2 style="text-align:center; margin-bottom:8px">Bigger or smaller, instantly. <kbd>⌘+</kbd> <kbd>⌘−</kbd> <kbd>⌘0</kbd></h2>
      <p class="lede" style="margin:0 auto 28px; text-align:center">
        Zoom the grid on the fly — the terminal re-measures and resizes the PTY
        (a real <span class="pill" style="margin:0">SIGWINCH</span>), so <code>vim</code>,
        <code>htop</code> and friends reflow correctly. <kbd>⌘0</kbd> snaps back to default.
      </p>
      <div class="ba">
        <div class="mini"><span class="lbl">⌘−  11px</span>$ uname -sm
Darwin arm64</div>
        <div class="arrow">→</div>
        <div class="mini"><span class="lbl">⌘+  18px</span>$ uname -sm
Darwin arm64</div>
      </div>
    </div>
  </section>

  <!-- 6 — themeable (ties into the toggle) -->
  <section class="slide">
    <div class="inner">
      <div class="kicker" style="text-align:center">Make it yours</div>
      <h2 style="text-align:center; margin-bottom:6px">Dark or light, chrome <i>and</i> grid.</h2>
      <p class="lede" style="margin:0 auto 26px; text-align:center">
        A retro phosphor glow by default, a crisp light mode when you want it.
        <b>Try the ◐ toggle up top</b> — this page is wearing tty's Dracula and
        GitHub&nbsp;Light right now.
      </p>
      <div class="themes">
        <div class="swatch" style="background:#1d2021">
          <div class="h" style="color:#8ec07c">phosphor</div>
          <div class="b" style="color:#ebdbb2"><span style="color:#b8bb26">$</span> echo <span style="color:#fabd2f">"✦"</span></div>
        </div>
        <div class="swatch" style="background:#282a36">
          <div class="h" style="color:#bd93f9">Dracula</div>
          <div class="b" style="color:#f8f8f2"><span style="color:#50fa7b">$</span> echo <span style="color:#f1fa8c">"✦"</span></div>
        </div>
        <div class="swatch" style="background:#002b36">
          <div class="h" style="color:#268bd2">Solarized</div>
          <div class="b" style="color:#839496"><span style="color:#859900">$</span> echo <span style="color:#2aa198">"✦"</span></div>
        </div>
        <div class="swatch" style="background:#ffffff">
          <div class="h" style="color:#8250df">GitHub Light</div>
          <div class="b" style="color:#24292e"><span style="color:#1a7f37">$</span> echo <span style="color:#0a3069">"✦"</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 7 — embeddable -->
  <section class="slide">
    <div class="inner cols">
      <div>
        <div class="kicker">One terminal, two homes</div>
        <h2>The widget that powers fed's IDE.</h2>
        <ul class="feat">
          <li><b>cathode</b> — the engine: a VT/ANSI parser, the screen grid, and a real PTY. Pure Rust, no UI.</li>
          <li><b>phosphor</b> — the iced widget that renders it: colors, attributes, scrollback, mouse copy.</li>
          <li>tty is thin glue over the two — and the <i>same</i> crates drop straight into <b><a href="https://github.com/nycjv321/fed">fed</a></b>'s integrated terminal panel.</li>
        </ul>
      </div>
      <div class="win">
        <div class="bar"><div class="dot r"></div><div class="dot y"></div><div class="dot g"></div></div>
        <div class="code">
          <div class="ln"><div class="c"><span class="cm">// embed a terminal in any iced app</span></div></div>
          <div class="ln"><div class="c"><span class="k">use</span> <span class="t">phosphor</span>::terminal;</div></div>
          <div class="ln cur"><div class="c">terminal(screen, style, font, size, ..)<span class="caret"></span></div></div>
        </div>
        <div class="foot"><span>cathode · phosphor</span><span>embeddable widget</span></div>
      </div>
    </div>
  </section>

  <!-- 8 — closer / download -->
  <section class="slide">
    <div class="inner" style="text-align:center">
      <div class="kicker">Native. Fast. Yours.</div>
      <h1 style="font-size:clamp(34px,6vw,64px)">Give tty a run.</h1>
      <p class="lede" style="margin:18px auto 0">
        Grab the signed, notarized macOS app, or clone and run it yourself —
        you'll be at a prompt in seconds. Built on Rust + iced, GPU-rendered with
        wgpu. Linux and Windows are on the way.
      </p>
      <div class="downloads">
        <a class="dl" href="${LATEST}"><span class="plat">Download for macOS</span><span class="arch">universal · Apple Silicon + Intel</span></a>
      </div>
      <div class="install">
        <div class="run">cargo run -p tty</div>
      </div>
      <div class="cta" style="margin-top:24px">
        <a class="btn ghost" href="${REPO}">View on GitHub</a>
        <a class="btn coffee" href="${COFFEE}">☕ Buy me a coffee</a>
      </div>
    </div>
  </section>
`;
---

<Layout
  title="tty — the fast terminal in Rust"
  description="tty is a fast, focused, GPU-accelerated terminal written in Rust — tabs, scrollback, mouse select & copy, full ANSI color, and output-driven repaint. Built on the cathode engine and phosphor widget. No Electron."
>
  <div class="hint">← → or space to explore</div>
  <div class="brand-foot">Rust · wgpu · zero Electron</div>

  <div class="deck" id="deck" set:html={deck}></div>

  <div class="nav">
    <div class="arrows"><button id="prev" aria-label="previous">‹</button></div>
    <div class="dots" id="dots"></div>
    <div class="arrows"><button id="next" aria-label="next">›</button></div>
    <div class="count" id="count"></div>
  </div>

  <script>
    const slides = [...document.querySelectorAll(".slide")];
    const dotsEl = document.getElementById("dots")!;
    const countEl = document.getElementById("count")!;
    let i = 0;
    slides.forEach((_, n) => {
      const b = document.createElement("b");
      b.onclick = () => go(n);
      dotsEl.appendChild(b);
    });
    const dots = [...dotsEl.children];
    function go(n: number) {
      i = Math.max(0, Math.min(slides.length - 1, n));
      slides.forEach((s, k) => s.classList.toggle("active", k === i));
      dots.forEach((d, k) => d.classList.toggle("on", k === i));
      countEl.textContent = i + 1 + " / " + slides.length;
    }
    document.getElementById("next")!.onclick = () => go(i + 1);
    document.getElementById("prev")!.onclick = () => go(i - 1);
    addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight" || e.key === " " || e.key === "PageDown") {
        go(i + 1);
        e.preventDefault();
      }
      if (e.key === "ArrowLeft" || e.key === "PageUp") {
        go(i - 1);
        e.preventDefault();
      }
      if (e.key === "Home") go(0);
      if (e.key === "End") go(slides.length - 1);
    });
    go(0);
  </script>
</Layout>
