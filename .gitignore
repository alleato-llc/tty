/target
**/*.rs.bk
Cargo.lock.orig

# web/ landing page
web/node_modules
web/dist
web/.astro

# Intermediates from snapshot.rs `generate_landing_shots`: it renders through
# `matches_image`, which writes `_shot-<name>-<backend>.png` here, then copies the
# result into web/public/shots. The copies are the deliverable; these are scratch
# (40 of them after a run) and were showing up as untracked noise.
tty/snapshots/_shot-*

# Animation frames, likewise scratch: the generator renders them into the shots
# directory and web/scripts/build-shot-anims.sh muxes them into the committed
# <name>[-theme].webp, then deletes them. Ignored so an interrupted run cannot
# leave 28 stray PNGs staged.
web/public/shots/_anim-*

.DS_Store
